{
  "manifest_version": 3,
  "name": "Chess.com Auto-Next Puzzle (Firefox)",
  "version": "1.1.0",
  "description": "Automatically clicks the Next or Continue button after completing Chess.com puzzles.",
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "autonextpuzzle@bewf.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "action": {
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/puzzles*"
      ],
      "js": [
        "src/storage.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
